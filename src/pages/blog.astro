---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import RevealOnScroll from '@/components/RevealOnScroll'
import BlogCard from '@/components/BlogCard.astro'
import SectionHeader from '@/components/SectionHeader.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
}
---

<Base title="Blog" description="Articles about web development, e-commerce, and engineering.">
  <div class="py-24">
    <div class="portfolio-section-wide">
      <RevealOnScroll client:visible>
        <SectionHeader number="01" label="Blog" heading="Writing & thoughts." description="Articles about web development, e-commerce, and engineering." />
      </RevealOnScroll>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {posts.map((post, i) => (
          <RevealOnScroll delay={i * 100} client:visible>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.date)}
              tag={post.data.tag}
              readTime={post.data.readTime}
              href={`/blog/${post.id.replace(/\.md$/, '')}`}
            />
          </RevealOnScroll>
        ))}
      </div>
    </div>
  </div>
</Base>
