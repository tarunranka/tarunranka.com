---
import Base from '@/layouts/Base.astro'
import RevealOnScroll from '@/components/RevealOnScroll'
import SectionHeader from '@/components/SectionHeader.astro'
import SkillGrid from '@/components/SkillGrid.astro'

const experiences = [
  {
    date: 'Aug 2016 — Present',
    title: 'Front-End Developer / Full Stack Developer',
    company: 'Sharaf DG',
    location: 'Dubai, UAE',
    bullets: [
      'Core engineering member from day one, building Sharaf DG\'s $82M e-commerce platform serving 2.7M+ monthly visitors — website, marketplace, OMS, and in-store Kiosk — across 6 markets (UAE, Saudi Arabia, Bahrain, Egypt, Oman). Drove architecture decisions and code standards across the full digital ecosystem.',
      'Led the full-stack build for the Saudi Arabia market launch from scratch, delivering Arabic RTL localization, regulatory compliance, ETA-based area selection, National Address integration, and Tabby payment — expanding the platform to the company\'s largest new market.',
      'Architected a multi-country shipping engine with Bullet Delivery (same-day) via Shipsy across 3 countries, including configurable shipping matrix, Click & Collect, Store Pickup, and real-time location-based delivery.',
      'Led end-to-end integration of 6 payment gateways — APS, Checkout.com, Tabby BNPL, Tamara BNPL, STC Pay, and Paymob — processing transactions across all markets with checkout flows, webhook handlers, and Easy Payment Plans.',
      'Implemented Sift fraud detection, significantly reducing chargebacks and fraudulent transactions. Built end-to-end fraud review workflow integrated across payment and order systems.',
      'Implemented site-wide product search using Algolia with indexing, relevance tuning, and search UI — powering discovery across 100K+ products with sub-second response times.',
      'Shipped 15+ customer-facing features including Trade-In / BTS Buyback, Digital Cards, Subscriptions, A+ Content on PDP, OTP-based Login & Registration, Scratch & Win campaigns, and Apple NPI launches.',
      'Built self-service Return & Refund workflows end to end. Implemented Synerise as the push notification, recommendation engine, and mailer engine with real-time order synchronization feeds.',
      'Led marketplace migration from Mirakl to SellerHub across front-end and backend, developing FBO Shipping, seller portal features, and display unit logic.',
      'Integrated 6+ analytics platforms (GA4, Mixpanel, Google Merchant Center, TikTok/Snapchat pixels, SEO, schema/sitemap) driving 51% organic search traffic.',
      'Established E2E automated testing with Playwright across all 6 markets. Set up CI/CD pipelines via Bitbucket Pipelines with linting, structured code reviews, and engineering best practices.',
      'Led development of the in-store Kiosk application (UAE) with barcode scanning, payment collection, and product browsing capabilities.',
      'Mentored junior developers, managed external vendor teams, led R&D initiatives, and owned sprint planning and stakeholder communication across all 6 markets.',
    ],
  },
  {
    date: 'Jun 2013 — Aug 2016',
    title: 'Lead Engineer',
    company: 'Born Group',
    location: 'India',
    bullets: [
      'Led a team of JavaScript developers building enterprise e-commerce solutions on Hybris and Magento platforms.',
      'Restructured estimation, design, and communication processes, reducing project turnaround times and improving delivery quality.',
      'Developed responsive, cross-device themes for complex catalog and checkout flows across desktop, tablet, and mobile.',
    ],
  },
  {
    date: 'Jun 2010 — Jun 2013',
    title: 'Web Developer',
    company: 'EC Software India',
    location: 'Chennai, India',
    bullets: [
      'Designed and developed web catalog applications with product search, bookmarking, and social sharing capabilities.',
      'Built adaptive, multi-device themes ensuring consistent cross-browser experiences.',
    ],
  },
]

const skillCategories = [
  { name: 'Languages & Frameworks', skills: ['JavaScript (ES6+)', 'TypeScript', 'React', 'Redux', 'Next.js', 'Node.js', 'Python', 'PHP', 'Laravel', 'HTML5', 'CSS3', 'SASS/LESS'] },
  { name: 'Backend & APIs', skills: ['REST', 'GraphQL', 'Node.js', 'PHP/Laravel', 'Hybris', 'Magento', 'WooCommerce', 'NetSuite'] },
  { name: 'Payments & Integrations', skills: ['Checkout.com', 'APS', 'Tabby', 'Tamara', 'STC Pay', 'Paymob', 'Sift', 'Algolia'] },
  { name: 'Cloud & DevOps', skills: ['AWS', 'Docker', 'Vercel', 'Bitbucket Pipelines', 'CI/CD', 'ELK Stack', 'Pusher'] },
  { name: 'Data & Analytics', skills: ['GA4', 'Mixpanel', 'Google Merchant Center', 'Synerise'] },
  { name: 'Testing & Tools', skills: ['Playwright', 'Git', 'Webpack', 'Gulp', 'NPM/Yarn', 'Sanity CMS', 'Figma', 'JIRA'] },
]

const education = [
  { institution: 'Amity University', degree: 'Master of Business Administration (MBA)', date: 'In Progress' },
  { institution: 'Misrimal Navajee Munoth Jain Engineering College', degree: 'Bachelor of Engineering, Information Technology', date: '2006 — 2010' },
]

const certifications = [
  'Next.js Fundamentals (v4)',
  'Website Accessibility (v3)',
  'Tailwind CSS 4+',
  'Playwright (Egghead)',
  'Cursor & Claude Code: Professional AI Setup',
  'Practical Prompt Engineering',
  'Go & Vanilla JS: Fullstack Without Frameworks',
  'Complete Intro to React (v8)',
  'Full Stack for Front-End Engineers (v3)',
  'Intro to Product Management',
  'Software Developer Success: Soft Skills & Testing',
]
---

<Base title="Resume" description="Tarun Ranka — Front-End Developer & Full Stack Engineer with 15+ years of experience.">
  <div class="py-24">
    <!-- Header with download button -->
    <section class="pb-24">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
            <SectionHeader number="00" label="Resume" heading="Tarun Ranka" description="Front-End Developer & Full Stack Engineer — Dubai, UAE" />
            <a href="/Tarun_Ranka_Resume.pdf" download class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-white rounded-lg font-medium hover:opacity-90 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </div>
        </RevealOnScroll>
        <RevealOnScroll client:visible>
          <div class="flex flex-wrap gap-4 text-sm text-ink-muted">
            <a href="mailto:tarunranka.m@gmail.com" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0l-8.628 5.313a3 3 0 01-3.144 0L2.25 6.75"/></svg>
              tarunranka.m@gmail.com
            </a>
            <a href="https://linkedin.com/in/tarunranka" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              linkedin.com/in/tarunranka
            </a>
            <a href="https://github.com/tarunranka" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-accent transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
              github.com/tarunranka
            </a>
            <span class="inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Dubai, UAE
            </span>
          </div>
        </RevealOnScroll>
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24 border-t border-border">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <SectionHeader number="01" label="Experience" heading="Work history." />
        </RevealOnScroll>
        <div class="flex flex-col gap-12">
          {experiences.map((exp, i) => (
            <RevealOnScroll delay={i * 100} client:visible>
              <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-4 md:gap-8">
                <div>
                  <p class="font-mono text-sm text-ink-dim">{exp.date}</p>
                  <p class="text-xs text-ink-dim mt-1">{exp.location}</p>
                </div>
                <div class="flex flex-col gap-4">
                  <div>
                    <h3 class="text-base font-bold text-ink">{exp.title}</h3>
                    <p class="text-accent text-sm font-medium">{exp.company}</p>
                  </div>
                  <ul class="space-y-2.5">
                    {exp.bullets.map((bullet) => (
                      <li class="text-ink-muted text-sm leading-relaxed pl-4 relative before:content-[''] before:absolute before:left-0 before:top-[9px] before:w-1.5 before:h-1.5 before:rounded-full before:bg-accent/40">{bullet}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </RevealOnScroll>
          ))}
        </div>
      </div>
    </section>

    <!-- Technical Skills -->
    <section class="py-24 border-t border-border">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <SectionHeader number="02" label="Skills" heading="Technical skills." />
        </RevealOnScroll>
        <RevealOnScroll client:visible>
          <SkillGrid categories={skillCategories} />
        </RevealOnScroll>
      </div>
    </section>

    <!-- Education -->
    <section class="py-24 border-t border-border">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <SectionHeader number="03" label="Education" heading="Academic background." />
        </RevealOnScroll>
        <div class="flex flex-col gap-2">
          {education.map((edu, i) => (
            <RevealOnScroll delay={i * 100} client:visible>
              <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-4 md:gap-8 p-5 rounded-lg transition-all duration-300 hover:bg-canvas-light/50">
                <div class="font-mono text-sm text-ink-dim">{edu.date}</div>
                <div>
                  <h3 class="text-base font-bold text-ink">{edu.institution}</h3>
                  <p class="text-ink-muted text-sm mt-1">{edu.degree}</p>
                </div>
              </div>
            </RevealOnScroll>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="py-24 border-t border-border">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <SectionHeader number="04" label="Certifications" heading="Continuous learning." />
        </RevealOnScroll>
        <RevealOnScroll client:visible>
          <div class="flex flex-wrap gap-2">
            {certifications.map((cert) => (
              <span class="px-3 py-1.5 rounded-full bg-accent-muted text-accent text-xs font-mono font-medium">{cert}</span>
            ))}
          </div>
        </RevealOnScroll>
      </div>
    </section>

    <!-- Download CTA -->
    <section class="py-28 border-t border-border text-center">
      <div class="portfolio-section">
        <RevealOnScroll client:visible>
          <p class="font-mono text-sm text-accent tracking-widest uppercase mb-4">05 — Download</p>
          <h2 class="text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">Get the PDF.</h2>
          <p class="text-base text-ink-muted max-w-[480px] mx-auto mb-10 leading-relaxed">Download a copy of my resume for your records.</p>
          <a href="/Tarun_Ranka_Resume.pdf" download class="inline-flex items-center gap-2 px-7 py-3 bg-accent text-white text-sm font-semibold rounded-lg hover:bg-accent/90 transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgba(16,185,129,0.25)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Resume
          </a>
        </RevealOnScroll>
      </div>
    </section>
  </div>
</Base>
