---
interface Props {
  date: string
  title: string
  company: string
  description: string
}

const { date, title, company, description } = Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-[140px_1fr] gap-4 md:gap-8 p-5 rounded-lg transition-all duration-300 hover:bg-canvas-light/50">
  <div class="font-mono text-sm text-ink-dim">{date}</div>
  <div class="flex flex-col gap-3">
    <div>
      <h3 class="text-base font-bold text-ink">{title}</h3>
      <p class="text-accent text-sm font-medium">{company}</p>
    </div>
    <p class="text-ink-muted text-sm">{description}</p>
  </div>
</div>
