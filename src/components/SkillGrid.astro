---
interface Props {
  categories: { name: string; skills: string[] }[]
}

const { categories } = Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  {categories.map((category) => (
    <div class="flex flex-col gap-4">
      <h3 class="text-xs font-mono font-bold text-accent uppercase tracking-wide">{category.name}</h3>
      <div class="flex flex-wrap gap-2">
        {category.skills.map((skill) => (
          <span class="px-3 py-1.5 rounded-full bg-accent-muted text-accent text-xs font-mono font-medium">{skill}</span>
        ))}
      </div>
    </div>
  ))}
</div>
