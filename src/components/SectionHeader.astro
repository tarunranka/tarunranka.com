---
interface Props {
  number: string
  label: string
  heading: string
  description?: string
}

const { number, label, heading, description } = Astro.props
---

<div class="flex flex-col gap-4 mb-10">
  <div class="flex items-center gap-2">
    <span class="text-xs font-mono font-bold text-accent uppercase tracking-widest">{number}</span>
    <span class="w-8 h-px bg-accent"></span>
    <span class="text-xs font-mono font-bold text-accent uppercase tracking-widest">{label}</span>
  </div>
  <h2 class="text-3xl md:text-4xl font-bold text-ink">{heading}</h2>
  {description && <p class="text-ink-muted text-base max-w-2xl">{description}</p>}
</div>
